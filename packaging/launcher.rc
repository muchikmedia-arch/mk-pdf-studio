      VALUE "OriginalFilename", "MK PDF Studio.exe"
      VALUE "ProductName", "MK PDF Studio"
      VALUE "ProductVersion", "1.3.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0C0A, 1200
  END
END
